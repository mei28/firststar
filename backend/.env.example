# YouTube Data API v3
YOUTUBE_API_KEY=your_api_key_here

# Redis接続URL
REDIS_URL=redis://localhost:6379/0

# PostgreSQL接続URL
DATABASE_URL=postgresql://youtube_finder:youtube_finder_pass@localhost:5432/youtube_channels

# CORS設定（フロントエンドのオリジン）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://mei28.github.io

# APIクォータ設定
QUOTA_DAILY_LIMIT=10000
QUOTA_WARNING_THRESHOLD=2000

# FastAPI設定
API_HOST=0.0.0.0
API_PORT=8000
